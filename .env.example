# Copy to .env and fill in. .env is gitignored -- never commit real values.
# See README.md for how to obtain each of these.

# Public origin, no trailing slash. Must match the Google redirect URI.
# For local testing: http://localhost:8138
ASSEMBLE_BASE_URL=https://assemble.example.com

# Google OAuth client (Web application) from the Google Cloud console.
ASSEMBLE_GOOGLE_CLIENT_ID=
ASSEMBLE_GOOGLE_CLIENT_SECRET=

# The first admin. Whoever signs in with this Google address (verified)
# becomes admin and is tied to that Google account from then on.
ASSEMBLE_ADMIN_EMAIL=you@example.com

# Where the SQLite database lives. Defaults to data/assemble.db, which is fine
# for a local build. The example compose file sets /data/assemble.db, on the
# mounted volume: the database is never baked into the image, and an unmounted
# path is lost on every redeploy.
#ASSEMBLE_DB_PATH=/data/assemble.db

# Optional. Defaults to :8080. This is the port *inside* the container; the
# host-side port is set in docker-compose.yml and is deliberately not 8080.
#ASSEMBLE_LISTEN=:8080

# Local development only. Replaces Google with a form that signs in as any
# email you type, so you can try invites and disabling with several people.
# Refuses to start unless ASSEMBLE_BASE_URL is http://localhost or 127.0.0.1
# and ASSEMBLE_LISTEN is a loopback address, e.g. 127.0.0.1:8138: it is for
# `go run` on your own machine, never a container or a server.
#ASSEMBLE_DEV_BYPASS=1
